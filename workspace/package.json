{
  "name": "hotkey-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 8668",
    "build": "node scripts/check.mjs && next build --webpack && node scripts/export.mjs && pagefind --site out --output-subdir _pagefind --force-language zh",
    "start": "node scripts/preview.mjs",
    "preview": "node scripts/preview.mjs",
    "index": "node scripts/index.mjs",
    "check": "node scripts/check.mjs && node --test tests/*.test.mjs && tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "local:init": "node scripts/local.mjs init",
    "local:start": "node scripts/local.mjs start",
    "local:read": "node scripts/local.mjs read"
  },
  "dependencies": {
    "github-slugger": "2.0.0",
    "next": "16.3.8",
    "nextra": "4.6.1",
    "nextra-theme-docs": "4.6.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.0.0",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "pagefind": "1.5.2",
    "typescript": "^5"
  }
}
