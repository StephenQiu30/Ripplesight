{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 8666",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 8666",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json",
    "format": "prettier --plugin prettier-plugin-tailwindcss --write .",
    "format:check": "prettier --plugin prettier-plugin-tailwindcss --check .",
    "openapi:generate": "openapi2ts && prettier --plugin prettier-plugin-tailwindcss --write src/api",
    "openapi:check": "pnpm openapi:generate && git diff --exit-code -- src/api"
  },
  "dependencies": {
    "@editorjs/code": "^2.9.4",
    "@editorjs/delimiter": "^1.4.2",
    "@editorjs/editorjs": "^2.31.7",
    "@editorjs/header": "^2.8.9",
    "@editorjs/inline-code": "^1.5.2",
    "@editorjs/list": "^2.0.9",
    "@editorjs/quote": "^2.7.6",
    "@editorjs/simple-image": "^1.6.0",
    "@editorjs/table": "^2.4.6",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.46.0",
    "marked": "^18.0.14",
    "next": "16.3.5",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.18.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "@umijs/openapi": "^1.14.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.7",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@12.3.4"
}
