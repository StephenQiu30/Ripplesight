{
  "name": "ripplesight-frontend",
  "description": "Ripplesight web app for public news reading and personal sentiment monitoring",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 8666",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 8666",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json",
    "format": "prettier --plugin prettier-plugin-tailwindcss --write .",
    "format:check": "prettier --plugin prettier-plugin-tailwindcss --check .",
    "openapi:generate": "openapi2ts && prettier --plugin prettier-plugin-tailwindcss --write src/api",
    "openapi:check": "pnpm openapi:generate && git diff --exit-code HEAD -- src/api && test -z \"$(git ls-files --others --exclude-standard -- src/api)\"",
    "docs:check": "node tests/docs/check.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.46.0",
    "marked": "^18.0.14",
    "next": "16.3.5",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.14.2",
    "recharts": "3.8.0",
    "sanitize-html": "^2.18.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "turndown": "^7.2.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@editorjs/editorjs": "^2.31.7",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "@types/turndown": "^5.0.6",
    "@umijs/openapi": "^1.14.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "github-slugger": "2.0.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.7",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "unified": "11.0.5",
    "unist-util-visit": "5.0.0",
    "vitest": "5.0.1",
    "yaml": "2.8.1"
  },
  "packageManager": "pnpm@12.3.4"
}
