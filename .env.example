# Shared configuration for API, Worker, CLI and Web. Keep env files at repository root.
# Copy to .env locally or .env.prod in production; no subdirectory env files.
# Both application entrypoints use the same service definitions.
# Production: always pass --env-file .env.prod; never commit actual credentials.

# Point at the existing database; URL-encode credentials in this complete URL.
# Containers reach host services through host.docker.internal (not 127.0.0.1).
HOTKEY_DATABASE_URL=postgresql+psycopg://hotkey:CHANGE_ME_URL_SAFE@host.docker.internal:5432/hotkey
HOTKEY_REDIS_URL=redis://host.docker.internal:6379/0
# Kafka must advertise addresses reachable from the application containers.
HOTKEY_KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:9092
HOTKEY_SOURCE_CREDENTIALS={}

# Existing object storage and capture service; no new containers are started.
HOTKEY_MINIO_ENDPOINT=host.docker.internal:9000
HOTKEY_MINIO_SECURE=false
HOTKEY_MINIO_ACCESS_KEY=
HOTKEY_MINIO_SECRET_KEY=
HOTKEY_MINIO_BUCKET=hotkey-evidence
HOTKEY_FIRECRAWL_ENABLED=false
HOTKEY_FIRECRAWL_BASE_URL=http://host.docker.internal:3002
HOTKEY_FIRECRAWL_TIMEOUT_SECONDS=20
HOTKEY_FIRECRAWL_MAX_RESPONSE_BYTES=2097152

# Separate host services; fixed ports are 1200 and 8888.
HOTKEY_RSSHUB_HOST=host.docker.internal
HOTKEY_SEARXNG_HOST=host.docker.internal
HOTKEY_COLLECTION_LOOKBACK_SECONDS=86400

# Application ports remain bound to localhost in both entrypoints.
HOTKEY_API_PORT=8667
HOTKEY_WEB_PORT=8666

# Optional infrastructure only (docker-compose-env.yml). Not needed for existing services.
# Existing volume names can be selected explicitly; blank uses the Compose project prefix.
HOTKEY_POSTGRES_VOLUME_NAME=
HOTKEY_REDIS_VOLUME_NAME=
HOTKEY_KAFKA_VOLUME_NAME=
# For a new combined stack, set DATABASE_URL to ...@postgres:5432/hotkey,
# REDIS_URL to redis://redis:6379/0 and KAFKA_BOOTSTRAP_SERVERS to kafka:9092.
# Use the same URL-safe password in DATABASE_URL and POSTGRES_PASSWORD.
HOTKEY_POSTGRES_PASSWORD=CHANGE_ME_URL_SAFE
HOTKEY_POSTGRES_PORT=5432
HOTKEY_REDIS_PORT=6379
# Optional Kafka host listener; the container listener stays kafka:9092.
HOTKEY_KAFKA_PORT=19092


# Product login. Origin must exactly match the public Web URL; production requires HTTPS.
HOTKEY_ENVIRONMENT=development
HOTKEY_WEB_ORIGIN=http://127.0.0.1:8666
# Public link base for notifications; keep it aligned with the Web origin.
HOTKEY_WEB_BASE_URL=http://127.0.0.1:8666
HOTKEY_SESSION_TTL_SECONDS=43200
# Optional GitHub OAuth App: requests user:email only.
# Fill the blank fields with the app Client ID/Secret; blanks keep login disabled.
# Callback URL: ${HOTKEY_WEB_ORIGIN}/api/identity/github/callback
HOTKEY_GITHUB_CLIENT_ID=
HOTKEY_GITHUB_CLIENT_SECRET=
# Independent authentication mail; never reuse the report-channel switch.
HOTKEY_AUTH_SMTP_HOST=
HOTKEY_AUTH_SMTP_PORT=587
HOTKEY_AUTH_SMTP_TLS=starttls
HOTKEY_AUTH_SMTP_USERNAME=
HOTKEY_AUTH_SMTP_PASSWORD=
HOTKEY_AUTH_SMTP_FROM_EMAIL=
# Generate a server-only random key with at least 32 bytes.
HOTKEY_EMAIL_CODE_HMAC_KEY=
# Optional explicit account whose enabled contact details may appear publicly.
HOTKEY_PUBLIC_CONTACT_OWNER_ID=
# Explicit publisher for anonymous information reading; blank keeps public content unpublished.
HOTKEY_PUBLIC_PUBLICATION_OWNER_ID=
# 公开分类 JSON 数组；[] 不筛选。六分类独立，未分类在非空集合下不输出。
HOTKEY_PUBLIC_PUBLICATION_CATEGORIES=[]

# Shared backend feature configuration; opt-in requests remain disabled by default.
HOTKEY_LOG_LEVEL=INFO
HOTKEY_KAFKA_GROUP_ID=hotkey-worker
HOTKEY_KAFKA_DELIVERY_TIMEOUT_SECONDS=10
HOTKEY_JOB_LEASE_SECONDS=75
HOTKEY_JOB_MAX_CATCHUP_WINDOWS=3
HOTKEY_BROWSER_STATE_DIR=
HOTKEY_AI_ENABLED=false
HOTKEY_EVENTS_CLUSTER_ENABLED=false
HOTKEY_EDITORIAL_SOURCES_ENABLED=false
HOTKEY_EDITORIAL_PUBLIC_REQUESTS_ENABLED=false
HOTKEY_EDITORIAL_X_AUTHORIZED=false
HOTKEY_EDITORIAL_MP_AUTHORIZED=false
HOTKEY_EDITORIAL_JINA_AUTHORIZED=false
HOTKEY_EDITORIAL_EXTERNAL_TOKENS={}
HOTKEY_EDITORIAL_INGRESS_HMAC_SECRET=
HOTKEY_EDITORIAL_PAID_CAPS_CNY_MICROS={}
HOTKEY_PUBLICATION_UPDATES_ENABLED=true
HOTKEY_MEDIA_MIRROR_ENABLED=false
HOTKEY_MEDIA_MIRROR_ALLOW_EXTERNAL_REQUESTS=false
HOTKEY_MEDIA_MIRROR_IMAGE_MAX_BYTES=15728640
HOTKEY_MEDIA_MIRROR_VIDEO_MAX_BYTES=67108864
HOTKEY_MEDIA_MIRROR_REDIRECT_HOSTS=[]
HOTKEY_SELECTBENCH_ENABLED=false
HOTKEY_PUBLICATION_INDEXING_ENABLED=false
HOTKEY_INDEXNOW_ENABLED=false
HOTKEY_INDEXNOW_EXTERNAL_REQUESTS_ENABLED=false
HOTKEY_SOURCE_ICONS_ENABLED=false
HOTKEY_SOURCE_ICONS_EXTERNAL_REQUESTS_ENABLED=false
HOTKEY_EMBEDDINGS_ENABLED=false
HOTKEY_EMBEDDING_MODEL=text-embedding-3-small
HOTKEY_EMBEDDING_BASE_URL=https://api.openai.com/v1
HOTKEY_EMBEDDING_DIMENSIONS=0
HOTKEY_EMBEDDING_TIMEOUT_SECONDS=30
HOTKEY_EMBEDDING_CURRENCY=
HOTKEY_EMBEDDING_INPUT_RATE_MICROS_PER_MILLION=
HOTKEY_REPORT_EDITIONS_ENABLED=false
HOTKEY_LEADERBOARD_ENABLED=false
HOTKEY_LEADERBOARD_EXTERNAL_REQUESTS_ENABLED=false
HOTKEY_CODEX_RESETS_ENABLED=false
HOTKEY_OPERATIONS_MAINTENANCE_ENABLED=false
HOTKEY_OPERATIONS_QUIET_MINUTES=360
HOTKEY_OPERATIONS_STARTUP_GRACE_MINUTES=20
HOTKEY_OPERATIONS_ALERTS_ENABLED=false
HOTKEY_FEEDBACK_FORWARD_ENABLED=false
HOTKEY_NOTIFICATIONS_ENABLED=false
HOTKEY_NOTIFICATION_SMTP_ENABLED=false
HOTKEY_NOTIFICATION_SMTP_PORT=587
HOTKEY_NOTIFICATION_SMTP_TLS=starttls
HOTKEY_NOTIFICATION_SMTP_TIMEOUT_SECONDS=10
HOTKEY_AI_MODEL_CATALOG={}
# 默认模型额外推理输出额度；不按模型名推断，0保持不启用。
# 兼容接口的输出/费用上限=max_output_tokens+reasoning_tokens，合计最多32768。
# 目录default的显式reasoning_tokens（含0）覆盖本项；其他具名项缺省为0。
# 例：在已有具名模型配置中加入 "reasoning_tokens":4000，能力选择仍用下面的映射。
# Codex app-server当前不支持设置输出上限，非零额度会在调用前拒绝；请为兼容模型配置。
HOTKEY_AI_REASONING_TOKENS=0
HOTKEY_AI_CAPABILITY_MODELS={}
HOTKEY_AI_PAID_REQUESTS_ENABLED=false
HOTKEY_AI_VISION_REQUESTS_ENABLED=false
HOTKEY_AI_OPENAI_COMPATIBLE_REQUESTS_ENABLED=false
HOTKEY_API_ORIGIN=http://127.0.0.1:8667

# Optional server-only credentials. Uncomment only when configuring the feature.
# HOTKEY_EMBEDDING_API_KEY=
# HOTKEY_INDEXNOW_KEY=
# HOTKEY_OPERATOR_TOKEN=
# HOTKEY_FEEDBACK_HMAC_SECRET=
# HOTKEY_NOTIFICATION_SMTP_HOST=
# HOTKEY_NOTIFICATION_SMTP_USERNAME=
# HOTKEY_NOTIFICATION_SMTP_PASSWORD=
# HOTKEY_NOTIFICATION_SMTP_FROM_EMAIL=
# Optional public metadata override; otherwise HOTKEY_WEB_ORIGIN is used.
# NEXT_PUBLIC_SITE_ORIGIN=
# Optional OpenAPI generator override; otherwise the local API is used.
# HOTKEY_OPENAPI_URL=http://127.0.0.1:8667/openapi.json

# Chrome collection: bind exactly one existing Ripplesight account UUID.
# The host runner reads the private Framefetch identity.env; never mount it into the API.
HOTKEY_BILIBILI_CHROME_OWNER_ID=
# HOTKEY_BILIBILI_CHROME_IDENTITY_ENV=/absolute/private/path/identity.env
