# Application Compose configuration. Copy to .env locally or .env.prod in production.
# Both application entrypoints use the same service definitions.
# Production: always pass --env-file .env.prod; never commit actual credentials.

# Point at the existing database; URL-encode credentials in this complete URL.
# Containers reach host services through host.docker.internal (not 127.0.0.1).
HOTKEY_DATABASE_URL=postgresql+psycopg://hotkey:CHANGE_ME_URL_SAFE@host.docker.internal:5432/hotkey
HOTKEY_REDIS_URL=redis://host.docker.internal:6379/0
# Kafka must advertise addresses reachable from the application containers.
HOTKEY_KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:9092
HOTKEY_SOURCE_CREDENTIALS={}

# Separate host services; fixed ports are 1200 and 8888.
HOTKEY_RSSHUB_HOST=host.docker.internal
HOTKEY_SEARXNG_HOST=host.docker.internal
HOTKEY_COLLECTION_LOOKBACK_SECONDS=86400

# Application ports remain bound to localhost in both entrypoints.
HOTKEY_API_PORT=8667
HOTKEY_WEB_PORT=8666

# Optional infrastructure only (docker-compose-env.yml). Not needed for existing services.
# For a new combined stack, set DATABASE_URL to ...@postgres:5432/hotkey,
# REDIS_URL to redis://redis:6379/0 and KAFKA_BOOTSTRAP_SERVERS to kafka:9092.
# Use the same URL-safe password in DATABASE_URL and POSTGRES_PASSWORD.
HOTKEY_POSTGRES_PASSWORD=CHANGE_ME_URL_SAFE
HOTKEY_POSTGRES_PORT=5432
HOTKEY_REDIS_PORT=6379
# Optional Kafka host listener; the container listener stays kafka:9092.
HOTKEY_KAFKA_PORT=19092

# Optional isolated browser runtime; platform collection remains disabled.
HOTKEY_BROWSER_ENABLED=false
# Private URL shared by browser and worker: ws://browser:3000/ws/<48 hex chars>.
HOTKEY_BROWSER_WS_URL=

# Product login. Origin must exactly match the public Web URL; production requires HTTPS.
HOTKEY_ENVIRONMENT=development
HOTKEY_WEB_ORIGIN=http://127.0.0.1:8666
# Public link base for notifications; keep it aligned with the Web origin.
HOTKEY_WEB_BASE_URL=http://127.0.0.1:8666
HOTKEY_SESSION_TTL_SECONDS=43200
# Optional GitHub OAuth App: requests user:email only.
# Fill the blank fields with the app Client ID/Secret; blanks keep login disabled.
# Callback URL: ${HOTKEY_WEB_ORIGIN}/api/identity/github/callback
HOTKEY_GITHUB_CLIENT_ID=
HOTKEY_GITHUB_CLIENT_SECRET=
# Independent authentication mail; never reuse the report-channel switch.
HOTKEY_AUTH_SMTP_HOST=
HOTKEY_AUTH_SMTP_PORT=587
HOTKEY_AUTH_SMTP_TLS=starttls
HOTKEY_AUTH_SMTP_USERNAME=
HOTKEY_AUTH_SMTP_PASSWORD=
HOTKEY_AUTH_SMTP_FROM_EMAIL=
# Generate a server-only random key with at least 32 bytes.
HOTKEY_EMAIL_CODE_HMAC_KEY=
# Optional explicit account whose enabled contact details may appear publicly.
HOTKEY_PUBLIC_CONTACT_OWNER_ID=
